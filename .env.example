# ========== 部署脚本配置 ==========
SERVER_HOST=your_server_ip
SERVER_PORT=22
SERVER_USER=root
SERVER_PASSWORD=your_server_password

# 远程部署路径
REMOTE_PATH=/www/wwwroot/happychat

# PM2 应用名称
PM2_APP_NAME=happychat-backend

# 保留备份数量
KEEP_RELEASES=3

# 部署完成后提示的访问地址（站点域名）
SITE_URL=https://chat.misaka12648.asia

# ========== 后端配置 ==========
# MongoDB 连接配置
MONGODB_URI=mongodb://localhost:27017/happychat

# 服务器端口
PORT=8080

# 后端监听地址：默认 127.0.0.1（仅本机可访问，统一经 Nginx 反向代理）。局域网调试可设 0.0.0.0
HOST=127.0.0.1

# CORS 生产白名单（英文逗号分隔多个来源）；本地 localhost/127.0.0.1 任意端口默认已放行
# CORS_ORIGINS=https://chat.misaka12648.asia

# JWT 配置（高强度随机密钥，生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"）
JWT_SECRET=replace_with_a_strong_random_key
# access token 有效期（默认 2h，用于接口/WebSocket 鉴权）
JWT_ACCESS_EXPIRES_IN=2h
# refresh token：独立密钥未配置时从 JWT_SECRET 派生；有效期默认 30d（滑动续期）
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# 上传目录
UPLOAD_DIR=./uploads

# 最大上传文件大小 (10MB)
MAX_FILE_SIZE=10485760

# ========== 前端配置 ==========
# 后端 API 服务地址（本地开发指向本机后端；npm run dev 会本地起后端并经 SSH 隧道连远程库）
VITE_API_BASE_URL=http://localhost:8080
VITE_WS_BASE_URL=ws://localhost:8080/ws
# 媒体文件地址：实体在生产服务器磁盘上，本地开发指向生产域名才能显示图片/视频
VITE_MEDIA_BASE_URL=https://chat.misaka12648.asia