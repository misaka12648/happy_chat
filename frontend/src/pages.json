{
	"easycom": {
		"autoscan": true,
		"custom": {
			"^uni-(.*)": "@dcloudio/uni-ui/lib/uni-$1/uni-$1.vue"
		}
	},
	"pages": [
		{
			"path": "pages/chat/list",
			"style": {
				"navigationBarTitleText": "消息"
			}
		},
		{
			"path": "pages/chat/detail",
			"style": {
				"navigationBarTitleText": "聊天"
			}
		},
		{
			"path": "pages/contacts/contacts",
			"style": {
				"navigationBarTitleText": "通讯录"
			}
		},
		{
			"path": "pages/profile/profile",
			"style": {
				"navigationBarTitleText": "我"
			}
		},
		{
			"path": "pages/login/login",
			"style": {
				"navigationBarTitleText": "登录"
			}
		},
		{
			"path": "pages/register/register",
			"style": {
				"navigationBarTitleText": "注册"
			}
		}
	],
	"globalStyle": {
		"navigationStyle": "custom",
		"navigationBarTextStyle": "white",
		"navigationBarTitleText": "HappyChat",
		"navigationBarBackgroundColor": "#FF6B6B",
		"backgroundColor": "#FAF9F7",
		"app-plus": {
			"background": "#FAF9F7"
		}
	},
	"tabBar": {
		"color": "#9CA3AF",
		"selectedColor": "#FF6B6B",
		"borderStyle": "white",
		"backgroundColor": "#FFFFFF",
		"list": [
			{
				"pagePath": "pages/chat/list",
				"text": "消息",
				"iconPath": "static/tabbar/chat.png",
				"selectedIconPath": "static/tabbar/chat-active.png"
			},
			{
				"pagePath": "pages/contacts/contacts",
				"text": "通讯录",
				"iconPath": "static/tabbar/contact.png",
				"selectedIconPath": "static/tabbar/contact-active.png"
			},
			{
				"pagePath": "pages/profile/profile",
				"text": "我",
				"iconPath": "static/tabbar/profile.png",
				"selectedIconPath": "static/tabbar/profile-active.png"
			}
		]
	}
}
